FASHION_DATABASE_URL=sqlite:///data/fashion_orders.db
FASHION_DEFAULT_SEASON=SS26
FASHION_DEFAULT_CUSTOMER_CODE=AA
FASHION_PREPAYMENT_PERCENTAGE=0.50
FASHION_SUPPORTED_MARKUP_PERCENTAGES=0.25,0.30,0.35
FASHION_CURRENCY=EUR
# Paste secrets in a local .env file. Never commit that file.
FASHION_APP_USERNAME=
FASHION_APP_PASSWORD=
FASHION_AI_API_KEY=
FASHION_AI_MODEL=
FASHION_AI_FALLBACK_MODELS=
# Optional: Google Programmable Search Engine with image search enabled.
FASHION_GOOGLE_CSE_API_KEY=
FASHION_GOOGLE_CSE_ID=
FASHION_SEARXNG_URL=http://127.0.0.1:8888

# Address the app is opened at (the Google OAuth redirect URI is derived from it).
FASHION_PUBLIC_BASE_URL=http://127.0.0.1:8001
# Google OAuth Web-application client (or upload the client JSON on the Connections page).
FASHION_GOOGLE_CLIENT_ID=
FASHION_GOOGLE_CLIENT_SECRET=
# Optional, for picking individual Drive files with the Google Picker.
FASHION_GOOGLE_API_KEY=
FASHION_GOOGLE_APP_ID=
# Recovery snapshots: interval while the app runs, and local snapshots kept.
FASHION_RECOVERY_INTERVAL_HOURS=6
FASHION_RECOVERY_KEEP_LOCAL=30
# Background jobs (analysis, sync, uploads, backups). Keep 1 for normal use.
FASHION_BACKGROUND_WORKER=1
